<odoo>
    <record id="todo_task_action_all" model="ir.actions.act_window">
        <field name="name">All Tasks</field>
        <field name="res_model">todo.task</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="todo_task_action_todo" model="ir.actions.act_window">
        <field name="name">To Do</field>
        <field name="res_model">todo.task</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('status', '=', 'todo')]</field>
    </record>

    <record id="todo_task_action_done" model="ir.actions.act_window">
        <field name="name">Done</field>
        <field name="res_model">todo.task</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('status', '=', 'done')]</field>
    </record>

    <menuitem id="todo_root_menu"
              name="To Do App"
              sequence="1"/>

    <menuitem id="todo_all_tasks_menu"
              name="All Tasks"
              parent="todo_root_menu"
              action="todo_task_action_all"
              sequence="1"/>

    <menuitem id="todo_todo_menu"
              name="To Do"
              parent="todo_root_menu"
              action="todo_task_action_todo"
              sequence="2"/>

    <menuitem id="todo_done_menu"
              name="Done"
              parent="todo_root_menu"
              action="todo_task_action_done"
              sequence="3"/>
</odoo>